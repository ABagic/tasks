{% schema %}
{
  "name": "Custom Hero Section",
  "settings": [
    {
      "type": "text",
      "id": "segment_class",
      "label": "Segment Class",
      "default": "hero reveal"
    },
    {
      "type": "image_picker",
      "id": "hero_image_class",
      "label": "Hero Image Class",
      "default": "hero-image"
    },
    {
      "type": "text",
      "id": "hero_content_class",
      "label": "Hero Content Class",
      "default": "hero-text"
    },
    {
      "type": "text",
      "id": "hero_paragraph_class",
      "label": "Hero Paragraph Class",
      "default": "hero-paragraph"
    },
    {
      "type": "text",
      "id": "hero_button_class",
      "label": "Hero Button Class",
      "default": "btn"
    },
    {
      "type": "text",
      "id": "hero_paragraph_hidden_class",
      "label": "Hero Paragraph Hidden Class",
      "default": "hero-paragraph hero-paragraph-show"
    },
    {
      "type": "text",
      "id": "hero_paragraph_show_class",
      "label": "Hero Paragraph Show Class",
      "default": "hero-paragraph-show"
    }
  ],
  "blocks": [],
  "max_blocks": 0,
  "presets": [
    {
      "name": "New Segment"
      }
  ]
}
{% endschema %}
